---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/PageHeading.astro";
import ProjectCover from "@/components/ProjectCover.astro";
import { getSortedProjects } from "@/lib/projects";

const projectCount = (await getSortedProjects()).length;

const destinations = [
  {
    label: "Accueil",
    description: "Qui je suis, et mes projets sélectionnés",
    href: "/",
  },
  {
    label: "Projets",
    description: `${projectCount} missions, du e-commerce à l'énergie`,
    href: "/projects/",
  },
  {
    label: "CV",
    description: "Mon parcours, téléchargeable en PDF",
    href: "/resume/",
  },
  {
    label: "Contact",
    description: "Écrivez-moi directement",
    href: "mailto:ahmadou.gue@gmail.com",
  },
];
---

<BaseLayout
  title="Page introuvable — Ahmadou Gueye"
  description="Cette page n'existe pas, ou plus."
  noindex
>
  <PageHeading
    title="Page introuvable"
    subtitle="Cette page n'existe pas, ou plus."
  />

  <div class="mt-12">
    <ProjectCover variant="hero" title="404" color="ochre" slug="not-found" />
  </div>

  <p class="mt-10 max-w-[540px]">
    Le lien est peut-être ancien, ou l'adresse a été mal copiée. Voici où
    reprendre la visite :
  </p>

  <nav aria-label="Pages du site" class="mt-12">
    <ul class="border-b border-ink/20">
      {destinations.map(({ label, description, href }) => (
        <li>
          <a
            href={href}
            class="group grid gap-1 border-t border-ink/20 py-5 sm:grid-cols-[160px_minmax(0,1fr)_auto] sm:items-baseline sm:gap-6"
          >
            <span class="font-serif text-[22px] leading-[1.3]">{label}</span>
            <span class="text-[14px] text-muted-strong transition-colors group-hover:text-ochre group-focus-visible:text-ochre">
              {description}
            </span>
            <span aria-hidden="true" class="hidden sm:block">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>