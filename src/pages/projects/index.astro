---
import PageHeading from "@/components/PageHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGrid from "@/components/ProjectGrid.astro";
import { getSortedProjects } from "@/lib/projects";

const projects = await getSortedProjects();
---

<BaseLayout
  title="Projets — Ahmadou Gueye"
  description="Missions front-end en Vue, Nuxt et React : Accor, Savelys, Dalkia, Maisons du Monde…"
>
  <PageHeading
    title="Projets"
    subtitle="Du e-commerce à l’énergie, en Vue et en React"
  />

  <div class="mt-18">
    <ProjectGrid projects={projects} prioritizeFirst />
  </div>
</BaseLayout>
