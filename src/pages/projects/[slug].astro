---
import { render } from "astro:content";
import { getSortedProjects } from "@/lib/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/PageHeading.astro";
import ProjectCover from "@/components/ProjectCover.astro";

export async function getStaticPaths() {
  const projects = await getSortedProjects();

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previousProject:
        projects[(index - 1 + projects.length) % projects.length],
      nextProject: projects[(index + 1) % projects.length],
    },
  }));
}

const { project, previousProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} — Ahmadou Gueye`}
  description={project.data.subtitle}
>
  <script is:inline slot="head">
    addEventListener("pageswap", (event) => {
      const destination = event.activation?.entry.url;
      const link = [...document.querySelectorAll("a[data-transition]")].find(
        (a) => a.href === destination,
      );
      try {
        if (event.viewTransition && link)
          sessionStorage.setItem(
            "transition-direction",
            link.dataset.transition,
          );
      } catch {
        // sessionStorage unavailable: navigate without directional transition
      }
    });
    addEventListener("pagereveal", (event) => {
      try {
        const direction = sessionStorage.getItem("transition-direction");
        sessionStorage.removeItem("transition-direction");
        if (event.viewTransition && direction)
          event.viewTransition.types.add(direction);
      } catch {
        // sessionStorage unavailable: navigate without directional transition
      }
    });
  </script>

  <article>
    <PageHeading title={project.data.title} subtitle={project.data.subtitle} />
    <div class="mt-12">
      <ProjectCover
        variant="hero"
        title={project.data.title}
        image={project.data.image}
        color="ink"
      />
    </div>
    <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-ink/20 pt-4 text-sm">
      <div>
        <dt class="text-muted-strong">Année</dt>
        <dd>{project.data.years}</dd>
      </div>
      <div>
        <dt class="text-muted-strong">Rôle</dt>
        <dd>{project.data.role}</dd>
      </div>
      <div>
        <dt class="text-muted-strong">Stack</dt>
        <dd>{project.data.stack.join(", ")}</dd>
      </div>
    </dl>

    <div class="project-content mt-16 max-w-[860px]">
      <Content />
    </div>

    <nav
      aria-label="Navigation entre projets"
      class="mt-24 grid gap-4 border-t border-ink/20 pt-4 text-sm sm:grid-cols-[1fr_auto_1fr]"
    >
      <a
        href={`/projects/${previousProject.id}`}
        rel="prev"
        data-transition="previous"
      >
        <span aria-hidden="true">←</span> Projet précédent :{" "}
        {previousProject.data.title}
      </a>
      <a href="/projects">Tous les projets</a>
      <a
        href={`/projects/${nextProject.id}`}
        rel="next"
        data-transition="next"
        class="sm:text-right"
      >
        Projet suivant : {nextProject.data.title}{" "}
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
</BaseLayout>
