---
import PageHeading from "@/components/PageHeading.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGrid from "@/components/ProjectGrid.astro";
import { getFeaturedProjects } from "@/lib/projects";

const featuredProjects = await getFeaturedProjects();
const person = {
  "@type": "Person",
  name: "Ahmadou Gueye",
  jobTitle: "Développeur front-end",
  url: Astro.site?.href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  email: "ahmadou.gue@gmail.com",
  sameAs: [
    "https://www.linkedin.com/in/ahmadou-gueye",
    "https://github.com/ahmadou18",
    "https://www.malt.fr/profile/ahmadougueye",
    "https://www.collective.work/profile/ahmadou-gueye"
  ],
  knowsAbout: [
    "Développement front-end",
    "Vue.js",
    "Nuxt",
    "React",
    "Next.js",
    "AEM",
    "JavaScript",
    "Astro",
    "TypeScript",
    "Node.js",
    "Python",
    "Tailwind CSS",
    "Design System",
    "Storybook",
    "Accessibilité web (WCAG)",
    "Core Web Vitals",
  ],
};
const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: Astro.site?.href,
  mainEntity: person,
};
---

<BaseLayout
  title="Ahmadou Gueye — Développeur front-end à Paris"
  description="Ahmadou Gueye, développeur front-end freelance à Paris, spécialisé en Vue.js, Nuxt et React. Interfaces rapides et accessibles pour Accor et Dalkia."
>

  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(profilePageSchema)}
  />
  <PageHeading
    title="Ahmadou Gueye"
    subtitle="Développeur front-end à Paris"
  />

  <section id="a-propos" class="mt-10 max-w-[540px] space-y-3 scroll-mt-28">
    <p>
      Je suis Ahmadou Gueye, développeur front-end freelance basé à Paris, spécialisé en Vue.js, Nuxt et React. Depuis 2017, je conçois des interfaces rapides, accessibles et faciles à maintenir pour des entreprises comme Accor, Dalkia ou Maisons du Monde.
    </p>
    <p class="text-muted-strong">
      Du e-commerce à l’énergie, en passant par l’hôtellerie : Design Systems,
      performance et accessibilité.
    </p>
  </section>

  <section class="mt-24">
    <SectionHeader
      title="Projets sélectionnés"
      linkLabel="Tout"
      linkContext=" : voir tous les projets"
      linkHref="/projects/"
    />
    <ProjectGrid projects={featuredProjects} />
  </section>
</BaseLayout>
