---
import PageHeading from "@/components/Heading/PageHeading.astro";
import SectionHeader from "@/components/SectionHeader/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGrid from "@/components/ProjectGrid/ProjectGrid.astro";
import { getSortedProjects } from "@/lib/projects";

const projects = await getSortedProjects();
---

<BaseLayout
  title="Ahmadou Gueye — Développeur front-end, freelance"
  description="J'aide les équipes à construire des interfaces Vue et React rapides, accessibles et faciles à maintenir."
>
  <PageHeading
    title="Ahmadou Gueye"
    subtitle="Développeur front-end senior, freelance à Paris"
  />

  <section id="a-propos" class="mt-10 max-w-[540px] space-y-3 scroll-mt-28">
    <p>
      J’aide les équipes à construire des interfaces Vue et React rapides,
      accessibles et faciles à maintenir.
    </p>
    <p class="text-muted-strong">
      Du e-commerce à l’énergie : Accor, Maisons du Monde, Dalkia, Savelys. Vue
      3, Nuxt, React, Astro.
    </p>
  </section>

  <section class="mt-24">
    <SectionHeader
      title="Projets sélectionnés"
      linkLabel="Tout"
      linkContext=" : voir tous les projets"
      linkHref="/projects"
    />
    <ProjectGrid projects={projects.slice(0, 4)} />
  </section>
</BaseLayout>
