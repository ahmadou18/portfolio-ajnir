---
import PageHeading from "@/components/PageHeading.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGrid from "@/components/ProjectGrid.astro";
import { getFeaturedProjects } from "@/lib/projects";

const featuredProjects = await getFeaturedProjects();
---

<BaseLayout
  title="Ahmadou Gueye — Développeur front-end à Paris"
  description="J'aide les équipes à construire des interfaces Vue et React rapides, accessibles et faciles à maintenir."
>
  <PageHeading
    title="Ahmadou Gueye"
    subtitle="Développeur front-end à Paris"
  />

  <section id="a-propos" class="mt-10 max-w-[540px] space-y-3 scroll-mt-28">
    <p>
      J’aide les équipes à construire des interfaces Vue et React rapides,
      accessibles et faciles à maintenir.
    </p>
    <p class="text-muted-strong">
      Du e-commerce à l’énergie : Accor, Maisons du Monde, Dalkia, Savelys. Vue
      3, Nuxt, React, Astro.
    </p>
  </section>

  <section class="mt-24">
    <SectionHeader
      title="Projets sélectionnés"
      linkLabel="Tout"
      linkContext=" : voir tous les projets"
      linkHref="/projects/"
    />
    <ProjectGrid projects={featuredProjects} />
  </section>
</BaseLayout>
