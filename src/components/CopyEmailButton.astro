---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  email: string;
  size?: "small" | "large";
}
const { email, size = "small" } = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));

const sizes = {
  small: { iconSize: 14, buttonClass: "-m-[5px] p-[5px]" },
  large: { iconSize: 20, buttonClass: "p-3 leading-[0]" },
};
const { iconSize, buttonClass } = sizes[size];
---

<button
  type="button"
  data-copy-email={email}
  data-copied-message={t("copy.done")}
  hidden
  aria-label={t("copy.label")}
  class:list={[buttonClass, "cursor-pointer text-muted-strong transition-colors hover:text-ochre focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"]}
>
  <svg
    data-copy-icon
    viewBox="0 0 24 24"
    width={iconSize}
    height={iconSize}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="9" y="9" width="12" height="12" rx="2" />
    <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
  </svg>
  <svg
    data-copied-icon
    class="hidden"
    viewBox="0 0 24 24"
    width={iconSize}
    height={iconSize}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 6 9 17l-5-5" />
  </svg>
</button>
<span role="status" class="sr-only" data-copy-status></span>

<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>("[data-copy-email]");

  buttons.forEach((button) => {
    const copyIcon = button.querySelector<SVGElement>("[data-copy-icon]");
    const copiedIcon = button.querySelector<SVGElement>("[data-copied-icon]");
    const status = button.nextElementSibling;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.hidden = false;

    button.addEventListener("click", async () => {
      const email = button.dataset.copyEmail;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }

      copyIcon?.classList.toggle("hidden", true);
      copiedIcon?.classList.toggle("hidden", false);
      if (status) status.textContent = button.dataset.copiedMessage ?? "";

      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        copyIcon?.classList.toggle("hidden", false);
        copiedIcon?.classList.toggle("hidden", true);
        if (status) status.textContent = "";
      }, 2000);
    });
  });
</script>
