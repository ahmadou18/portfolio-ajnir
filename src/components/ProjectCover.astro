---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export type CoverColor = "ink" | "ochre";

interface Props {
  title: string;
  slug: string;
  image?: ImageMetadata | string;
  color: CoverColor;
  variant: "card" | "hero";
  priority?: boolean;
}
const { title, image, color, variant, slug, priority = false } = Astro.props;

const backgroundByColor: Record<CoverColor, string> = {
  ink: "bg-ink",
  ochre: "bg-ochre",
};

const optionsByVariant: Record<
  Props["variant"],
  { frame: string; title: string; image: string; sizes: string }
> = {
  card: {
    frame: "aspect-square",
    title: "text-5xl",
    image:
      "motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-105 motion-safe:group-focus-visible:scale-105",
    sizes: "(min-width: 640px) calc(50vw - 46px), calc(100vw - 76px)",
  },
  hero: {
    frame: "aspect-[16/10] sm:aspect-[3/1]",
    title: "text-5xl sm:text-7xl",
    image: "",
    sizes: "100vw",
  },
};

// The hero is always the LCP; a card only when it is the first one above the fold.
const isPriority = variant === "hero" || priority;
const imageWidths = [400, 640, 800, 1200, 1600, 2400];
---

<div
  style={`view-transition-name: cover-${slug}`}
  class:list={[
    "relative grid place-items-center overflow-hidden rounded-xs text-paper [view-transition-class:project-cover]",
    optionsByVariant[variant].frame,
    image ? "bg-ink" : backgroundByColor[color],
  ]}
>
  {image && (
    <>
      {typeof image === "string" ? (
        <Image
          src={image}
          alt=""
          inferSize
          widths={imageWidths}
          quality={70}
          sizes={optionsByVariant[variant].sizes}
          loading={isPriority ? "eager" : "lazy"}
          fetchpriority={isPriority ? "high" : "auto"}
          class:list={[
            "absolute inset-0 size-full object-cover",
            optionsByVariant[variant].image,
          ]}
        />
      ) : (
        <Image
          src={image}
          alt=""
          widths={imageWidths}
          quality={70}
          sizes={optionsByVariant[variant].sizes}
          loading={isPriority ? "eager" : "lazy"}
          fetchpriority={isPriority ? "high" : "auto"}
          class:list={[
            "absolute inset-0 size-full object-cover",
            optionsByVariant[variant].image,
          ]}
        />
      )}
      <div class="absolute inset-0 bg-ink/55" aria-hidden="true"></div>
    </>
  )}
  <span
    class:list={[
      "relative px-5 text-center font-serif font-light",
      optionsByVariant[variant].title,
    ]}
  >
    {title}
  </span>
</div>
