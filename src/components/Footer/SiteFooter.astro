---
import CopyEmailButton from "@/components/CopyEmailButton/CopyEmailButton.astro";
const email = "ahmadou.gue@gmail.com";

const socialLinks = [
  { label: email, href: `mailto:${email}`, copyValue: email },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/ahmadou-gueye" },
  { label: "GitHub", href: "https://github.com/ahmadou18" },
];
---

<footer id="contact" class="mt-30 scroll-mt-28 border-t border-ink/20 pt-4 text-sm">
  <ul class="flex flex-wrap gap-x-6 gap-y-2">
    {socialLinks.map(({ label, href, copyValue }) => (
      <li>
        <a href={href}>{label}</a>
        {copyValue && <CopyEmailButton email={copyValue} />}
      </li>
    ))}
    <li class="ml-auto text-muted-strong">Paris</li>
  </ul>
</footer>
