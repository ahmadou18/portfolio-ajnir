---
import type { CollectionEntry } from "astro:content";
import ProjectCover, {
  type CoverColor,
} from "@/components/ProjectCover.astro";
interface Props {
  title: string;
  subtitle: string;
  slug:string,
  years: string;
  href: string;
  color: CoverColor;
  image?: CollectionEntry<"projects">["data"]["image"];
}
const { title, subtitle, years, href, color, image, slug } = Astro.props;
---

<a
  href={href}
  class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ochre"
>
  <ProjectCover variant="card" title={title} color={color} image={image} slug={slug}/>
  <div class="mt-3 flex justify-between gap-4 text-sm text-muted-strong transition-colors group-hover:text-ochre group-focus-visible:text-ochre">
    <span>
      {subtitle} <span aria-hidden="true">→</span>
    </span>
    <span>{years}</span>
  </div>
</a>
