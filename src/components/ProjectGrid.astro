---
import ProjectCard from "@/components/ProjectCard.astro";
import type { CoverColor } from "@/components/ProjectCover.astro";
import { getLangFromUrl, getLocalizedPath } from "@/i18n/utils";
import type { Project } from "@/lib/projects";

interface Props {
  projects: Project[];
  /** Loads the first card eagerly: use it when the grid is above the fold (LCP). */
  prioritizeFirst?: boolean;
}
const { projects, prioritizeFirst = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);

function getCheckerColor(index: number): CoverColor {
  const row = Math.floor(index / 2);
  const column = index % 2;

  return (row + column) % 2 === 0 ? "ink" : "ochre";
}
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-10">
  {projects.map((project, index) => (
    <ProjectCard
      {...project.data}
      color={getCheckerColor(index)}
      href={getLocalizedPath(lang, `/projects/${project.id}/`)}
      slug={project.id}
      priority={prioritizeFirst && index === 0}
    />
  ))}
</div>
