---
import CopyEmailButton from "@/components/CopyEmailButton.astro";
import { site } from "@/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  showCopyButton?: boolean;
}
const { showCopyButton = true } = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));

const socialLinks = [
  { label: site.email, href: `mailto:${site.email}`, copyValue: site.email },
  { label: "LinkedIn", href: site.linkedinUrl },
  { label: "GitHub", href: site.githubUrl },
];
---

<footer class="mt-30 border-t border-ink/20 pt-4 text-sm">
  <ul class="flex flex-wrap gap-x-6 gap-y-2">
    {socialLinks.map(({ label, href, copyValue }) => (
      <li>
        <a href={href}>{label}</a>
        {showCopyButton && copyValue && <CopyEmailButton email={copyValue} />}
      </li>
    ))}
    <li class="ml-auto text-muted-strong">{t("footer.city")}</li>
  </ul>
</footer>
