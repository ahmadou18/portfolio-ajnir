---
import CopyEmailButton from "@/components/CopyEmailButton.astro";
import { site } from "@/config";

const socialLinks = [
  { label: site.email, href: `mailto:${site.email}`, copyValue: site.email },
  { label: "LinkedIn", href: site.linkedinUrl },
  { label: "GitHub", href: site.githubUrl },
];
---

<footer id="contact" class="mt-30 scroll-mt-28 border-t border-ink/20 pt-4 text-sm">
  <ul class="flex flex-wrap gap-x-6 gap-y-2">
    {socialLinks.map(({ label, href, copyValue }) => (
      <li>
        <a href={href}>{label}</a>
        {copyValue && <CopyEmailButton email={copyValue} />}
      </li>
    ))}
    <li class="ml-auto text-muted-strong">Paris</li>
  </ul>
</footer>
