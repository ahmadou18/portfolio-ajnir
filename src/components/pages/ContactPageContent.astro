---
import CopyEmailButton from "@/components/CopyEmailButton.astro";
import PageHeading from "@/components/PageHeading.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const externalProfiles = [
  { service: "LinkedIn", description: t("contact.linkedin"), href: site.linkedinUrl },
  { service: "Malt", description: t("contact.malt"), href: site.maltUrl },
  { service: "Collective", description: t("contact.collective"), href: site.collectiveUrl },
  { service: "GitHub", description: t("contact.github"), href: site.githubUrl },
];
---

<BaseLayout
  title={t("meta.contactTitle")}
  description={t("meta.contactDescription")}
  showFooterCopyButton={false}
>
  <PageHeading title={t("contact.title")} subtitle={t("contact.subtitle")} />

  <dl class="mt-18 border-b border-ink/20">
    <div class="grid gap-1 border-t border-ink/20 py-5 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-6">
      <dt class="text-[14px] text-muted-strong">{t("contact.email")}</dt>
      <dd class="flex items-center gap-2">
        <a
          href={`mailto:${site.email}`}
          class="font-serif text-[30px] leading-[1.15] font-light tracking-[-0.01em] [overflow-wrap:anywhere] sm:text-[48px]"
        >
          {site.email}
        </a>
        <CopyEmailButton email={site.email} size="large" />
      </dd>
    </div>
    <div class="grid gap-1 border-t border-ink/20 py-5 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-6">
      <dt class="text-[14px] text-muted-strong">{t("contact.availability")}</dt>
      <dd>
        <p class="flex items-center gap-2.5">
          <span class="size-2 shrink-0 rounded-full bg-available" aria-hidden="true"></span>
          {site.availability[lang]}
        </p>
        <p class="mt-0.5 text-[14px] text-muted-strong">{t("contact.status")}</p>
      </dd>
    </div>
  </dl>

  <section class="mt-24">
    <SectionHeader title={t("contact.elsewhere")} />
    <ul>
      {externalProfiles.map(({ service, description, href }) => (
        <li class="border-t border-ink/20">
          <a
            href={href}
            class="group grid gap-1 py-5 sm:grid-cols-[160px_minmax(0,1fr)_auto] sm:items-baseline sm:gap-6"
          >
            <span class="font-serif text-[22px] leading-[1.3] text-ink">{service}</span>
            <span class="text-[14px] text-muted-strong transition-colors group-hover:text-ochre group-focus-visible:text-ochre">
              {description}
            </span>
            <span class="hidden sm:inline" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
