---
import { render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/PageHeading.astro";
import ProjectCover from "@/components/ProjectCover.astro";
import type { Project } from "@/lib/projects";
import type { Lang } from "@/i18n/ui";
import { getLocalizedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
  project: Project;
  previousProject: Project;
  nextProject: Project;
}
const { lang, project, previousProject, nextProject } = Astro.props;
const t = useTranslations(lang);

const { Content } = await render(project);
const coverImage = project.data.image;

const shareImage = coverImage
  ? await getImage({
      src: coverImage,
      width: 2400,
      height: 1260,
      fit: "cover",
      format: "jpg",
      quality: 85,
    })
  : undefined;
---

<BaseLayout
  title={`${project.data.title} — Ahmadou Gueye`}
  description={project.data.subtitle}
  image={shareImage?.src}
  type="article"
>
  <script is:inline slot="head">
    addEventListener("pageswap", (event) => {
      const destination = event.activation?.entry.url;
      const link = [...document.querySelectorAll("a[data-transition]")].find(
        (a) => a.href === destination,
      );
      try {
        if (event.viewTransition && link)
          sessionStorage.setItem(
            "transition-direction",
            link.dataset.transition,
          );
      } catch {
        // sessionStorage unavailable: navigate without directional transition
      }
    });
    addEventListener("pagereveal", (event) => {
      try {
        const direction = sessionStorage.getItem("transition-direction");
        sessionStorage.removeItem("transition-direction");
        if (event.viewTransition && direction)
          event.viewTransition.types.add(direction);
      } catch {
        // sessionStorage unavailable: navigate without directional transition
      }
    });
  </script>

  <article>
    <PageHeading title={project.data.title} subtitle={project.data.subtitle} />
    <div class="mt-12">
      <ProjectCover
        variant="hero"
        title={project.data.title}
        image={project.data.image}
        color="ink"
        slug={project.id}
      />
    </div>
    <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-ink/20 pt-4 text-sm">
      <div>
        <dt class="text-muted-strong">{t("project.year")}</dt>
        <dd>{project.data.years}</dd>
      </div>
      <div>
        <dt class="text-muted-strong">{t("project.role")}</dt>
        <dd>{project.data.role}</dd>
      </div>
      <div>
        <dt class="text-muted-strong">{t("project.stack")}</dt>
        <dd>{project.data.stack.join(", ")}</dd>
      </div>
    </dl>

    <div class="project-content mt-16 max-w-[860px]">
      <Content />
    </div>

    <nav
      aria-label={t("project.navLabel")}
      class="mt-24 grid gap-4 border-t border-ink/20 pt-4 text-sm sm:grid-cols-[1fr_auto_1fr]"
    >
      <a
        href={getLocalizedPath(lang, `/projects/${previousProject.id}/`)}
        rel="prev"
        data-transition="previous"
      >
        <span aria-hidden="true">←</span> {t("project.previous")}{t("punctuation.colon")}{" "}
        {previousProject.data.title}
      </a>
      <a href={getLocalizedPath(lang, "/projects/")}>{t("project.all")}</a>
      <a
        href={getLocalizedPath(lang, `/projects/${nextProject.id}/`)}
        rel="next"
        data-transition="next"
        class="sm:text-right"
      >
        {t("project.next")}{t("punctuation.colon")} {nextProject.data.title}{" "}
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
</BaseLayout>
