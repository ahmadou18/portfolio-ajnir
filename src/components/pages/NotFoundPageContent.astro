---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeading from "@/components/PageHeading.astro";
import ProjectCover from "@/components/ProjectCover.astro";
import { getSortedProjects } from "@/lib/projects";
import { site } from "@/config";
import type { Lang } from "@/i18n/ui";
import { getLocalizedPath, useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projectCount = (await getSortedProjects(lang)).length;

const destinations = [
  {
    label: t("notFound.home"),
    description: t("notFound.homeDescription"),
    href: getLocalizedPath(lang, "/"),
  },
  {
    label: t("nav.projects"),
    description: t("notFound.projectsDescription").replace(
      "{count}",
      String(projectCount),
    ),
    href: getLocalizedPath(lang, "/projects/"),
  },
  {
    label: t("nav.resume"),
    description: t("notFound.resumeDescription"),
    href: getLocalizedPath(lang, "/resume/"),
  },
  {
    label: t("nav.contact"),
    description: t("notFound.contactDescription"),
    href: `mailto:${site.email}`,
  },
];
---

<BaseLayout
  title={t("meta.notFoundTitle")}
  description={t("notFound.subtitle")}
  noindex
>
  <PageHeading title={t("notFound.title")} subtitle={t("notFound.subtitle")} />

  <div class="mt-12">
    <ProjectCover variant="hero" title="404" color="ochre" slug="not-found" />
  </div>

  <p class="mt-10 max-w-[540px]">{t("notFound.text")}</p>

  <nav aria-label={t("notFound.navLabel")} class="mt-12">
    <ul class="border-b border-ink/20">
      {destinations.map(({ label, description, href }) => (
        <li>
          <a
            href={href}
            class="group grid gap-1 border-t border-ink/20 py-5 sm:grid-cols-[160px_minmax(0,1fr)_auto] sm:items-baseline sm:gap-6"
          >
            <span class="font-serif text-[22px] leading-[1.3]">{label}</span>
            <span class="text-[14px] text-muted-strong transition-colors group-hover:text-ochre group-focus-visible:text-ochre">
              {description}
            </span>
            <span aria-hidden="true" class="hidden sm:block">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>
