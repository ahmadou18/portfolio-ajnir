---
import Logo from "@/assets/logo.svg";
import { languages, type Lang } from "@/i18n/ui";
import {
  getLangFromUrl,
  getLocalizedPath,
  getTranslatedPath,
  useTranslations,
} from "@/i18n/utils";
import { site } from "@/config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const targetLang = (Object.keys(languages) as Lang[]).find(
  (otherLang) => otherLang !== lang,
)!;
// A 404 has no translated counterpart: link to the other language's home page.
const isNotFoundPage = /\/404\/?$/.test(Astro.url.pathname);
const translatedPath = isNotFoundPage
  ? getLocalizedPath(targetLang, "/")
  : getTranslatedPath(Astro.url, targetLang);

const navigationLinks = [
  { label: t("nav.projects"), href: getLocalizedPath(lang, "/projects/") },
  { label: t("nav.resume"), href: getLocalizedPath(lang, "/resume/") },
  { label: t("nav.contact"), href: getLocalizedPath(lang, "/contact/") },
];

const currentPath = Astro.url.pathname.replace(/\/?$/, "/");

function isCurrentPage(href: string) {
  if (!href.startsWith("/") || href.includes("#")) return false;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-10 bg-paper pt-4 pb-3 text-[14px] [view-transition-name:site-header]">
  <div class="grid grid-cols-[1fr_auto] items-end gap-x-6 gap-y-2.5 sm:grid-cols-[auto_1fr_auto] sm:gap-x-8">
    <a
      href={getLocalizedPath(lang, "/")}
      aria-label={t("header.homeLabel")}
      class="group order-1 flex items-center gap-2.5 py-1.5"
    >
      <Logo
        class="logo-trace h-[22px] w-auto stroke-[12] text-ink"
        aria-hidden="true"
      />
    </a>

    <nav
      aria-label={t("nav.label")}
      class="col-span-2 row-start-2 sm:col-span-1 sm:col-start-2 sm:row-start-1"
    >
      <ul class="grid grid-cols-3 gap-x-6">
        {navigationLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrentPage(href) ? "page" : undefined}
              class="block border-b border-ink/20 py-1.5 aria-[current=page]:border-ink"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col-start-2 row-start-1 flex items-baseline gap-4 sm:col-start-3">
      <a
        href={translatedPath}
        lang={targetLang}
        hreflang={targetLang}
        class="py-1.5 leading-none text-muted-strong transition-colors hover:text-ochre focus-visible:text-ochre"
      >
        {t("languageSwitcher.targetCode")}<span class="sr-only">, {t("languageSwitcher.targetName")}</span>
      </a>
      <a
        href={`mailto:${site.email}`}
        aria-label={t("header.emailLabel")}
        class="py-1.5 text-[18px] leading-none"
      >
        @
      </a>
    </div>
  </div>
</header>
