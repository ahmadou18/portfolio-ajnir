---
const navigationLinks = [
  { label: 'Projets', href: '/projects' },
  { label: 'À propos', href: '/#a-propos' },
  { label: 'CV', href: '[LIEN CV]' },
  { label: 'Contact', href: 'mailto:[TON EMAIL]' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');

function isCurrentPage(href: string) {
  if (!href.startsWith('/') || href.includes('#')) return false;
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-10 bg-paper pt-4 pb-3 text-[14px]">
  <div class="grid grid-cols-[1fr_auto] items-end gap-x-6 gap-y-2.5 sm:grid-cols-[auto_1fr_auto] sm:gap-x-8">
    <a href="/" class="py-1.5">Ahmadou Gueye</a>

    <nav aria-label="Navigation principale" class="col-span-2 row-start-2 sm:col-span-1 sm:col-start-2 sm:row-start-1">
      <ul class="grid grid-cols-2 gap-x-6 sm:grid-cols-4">
        {navigationLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrentPage(href) ? 'page' : undefined}
              class="block border-b border-ink/20 py-1.5 aria-[current=page]:border-ink"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="mailto:[TON EMAIL]"
      aria-label="Contact par email"
      class="col-start-2 row-start-1 py-1.5 text-[18px] leading-none sm:col-start-3"
    >
      @
    </a>
  </div>
</header>
